{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Capability for the Settings window: its events, title, theme, first show and focus, the settings file, the capability probe, its own request and close, and the ffmpeg path picker",
  "windows": ["settings"],
  "permissions": [
    "core:event:default",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "allow-load-settings",
    "allow-save-settings",
    "allow-restore-default-presets",
    "allow-reset-settings",
    "allow-start-capability-probe",
    "allow-take-settings-window-request",
    "allow-close-settings-window"
  ]
}
