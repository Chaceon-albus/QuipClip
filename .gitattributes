* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf

*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.rs    text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.exe   binary
*.dll   binary
*.zip   binary

# Files with no extension, or with an extension the list above does not cover.
# Without these lines a clone with core.autocrlf=true writes CRLF into them.
.gitignore      text eol=lf
.gitattributes  text eol=lf
.editorconfig   text eol=lf
.prettierignore text eol=lf
LICENSE         text eol=lf

*.lock  text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.svg   text eol=lf

*.icns  binary
*.woff  binary
*.woff2 binary
